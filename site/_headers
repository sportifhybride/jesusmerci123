/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; frame-src https://www.youtube-nocookie.com
/api/*
  Cache-Control: no-store
/admin*
  X-Robots-Tag: noindex, nofollow
/compte*
  X-Robots-Tag: noindex, nofollow
/espace*
  X-Robots-Tag: noindex, nofollow
/bibliotheque*
  X-Robots-Tag: noindex, nofollow
